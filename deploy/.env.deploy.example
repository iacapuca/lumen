# Copy to deploy/.env.deploy, fill in, then:
#   wrangler login                       # one-time, interactive
#   bash deploy/deploy-cloudflare.sh
#
# deploy/.env.deploy is gitignored — never commit real secrets.

# --- managed services you provide ---
NEON_DATABASE_URL=""     # Postgres (Neon/Supabase) for auth + dashboards registry + metering
CUBE_URL=""              # your Cube.dev instance, e.g. https://your.cubecloud.dev
CUBE_API_SECRET=""       # Cube CUBEJS_API_SECRET (signs the securityContext JWT)

# --- urls (fill after the first deploy if you don't know them yet) ---
CONTROL_PLANE_DOMAIN=""  # https://app.yourdomain.com  → BETTER_AUTH_URL
EDGE_WORKER_URL=""       # https://lumen-edge.<account>.workers.dev → control plane talks to this

# --- secrets: leave BLANK to auto-generate (saved back into this file on first run) ---
LUMEN_JWT_SECRET=""      # SHARED by edge + control plane (control plane mints, edge verifies)
BETTER_AUTH_SECRET=""    # control-plane session signing
LUMEN_API_KEY=""         # optional; gates POST /tokens (leave blank to keep it open)
