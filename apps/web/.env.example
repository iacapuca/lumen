# Local dev for the control plane (apps/web).
#   cp apps/web/.env.example apps/web/.env   # then fill in
# Loaded automatically by `pnpm dev` / `pnpm start` (--env-file-if-exists=.env).
#
# In production on Cloudflare these DON'T come from here — non-secret values live
# in apps/web/wrangler.jsonc `vars`, secrets are set with `wrangler secret put`,
# and Postgres comes from the Hyperdrive binding. See deploy/.env.deploy.example.

# --- server-only ---
# Postgres for Better Auth + dashboards + metering.
# Default matches the local Docker Compose Postgres (see infra/).
DATABASE_URL="postgres://lumen:lumen@localhost:5544/lumen"

# Better Auth session-signing secret. Generate one with:  openssl rand -base64 48
BETTER_AUTH_SECRET=""

# Public base URL of the control plane (Better Auth + cookie domain).
BETTER_AUTH_URL="http://localhost:3000"

# --- client (VITE_*) — inlined into the browser bundle at BUILD time ---
VITE_BETTER_AUTH_URL="http://localhost:3000"
# Where the browser/web component fetches embedded dashboards from (the edge
# runtime). Local edge dev defaults to http://localhost:8088.
VITE_LUMEN_RUNTIME_URL="http://localhost:8088"
