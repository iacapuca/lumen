# Local dev for the control plane (apps/web) — CLIENT-side (VITE_*) vars only.
#   cp apps/web/.env.example apps/web/.env   # then fill in
# Loaded by Vite itself (independent of Cloudflare bindings) and inlined into
# the browser bundle at build time.
#
# Server-side secrets/vars (BETTER_AUTH_SECRET, BETTER_AUTH_URL,
# LUMEN_INTERNAL_API_KEY) come from Cloudflare bindings instead — see
# .dev.vars.example (local) / wrangler.jsonc `vars` + `wrangler secret put`
# (prod). apps/web/src/lib/bindings.ts is the single accessor.

VITE_BETTER_AUTH_URL="http://localhost:3000"
# Where the browser/web component fetches embedded dashboards from (the edge
# runtime). Local edge dev defaults to http://localhost:8088.
VITE_LUMEN_RUNTIME_URL="http://localhost:8088"
