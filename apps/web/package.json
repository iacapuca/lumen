{
  "name": "@lumen/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Lumen control-plane UI — TanStack Start (React, SSR, file-based routing).",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config src/lib/auth.cli.ts --output src/lib/db/auth-schema.ts -y",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@fontsource-variable/geist": "^5.2.9",
    "@lumen/contracts": "workspace:*",
    "@lumen/embed-sdk": "workspace:*",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-devtools": "5.101.2",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.22.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^3.2.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.2",
    "typescript": "^6.0.2",
    "vite": "8.1.0",
    "wrangler": "^4.105.0"
  }
}
